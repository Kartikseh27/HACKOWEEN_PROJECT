# ==========================================
# KISAN CULTURE BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite default for macOS local development)
DATABASE_URL=sqlite:///./kisan_culture.db

# AI Engine (Google Gemini API - Free tier key from aistudio.google.com)
GEMINI_API_KEY=

# Meteorological Service (Open-Meteo is free & no key required; custom key optional)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Security & Upload Limits (25MB max for leaf photos & soil PDFs)
MAX_UPLOAD_SIZE_MB=25

