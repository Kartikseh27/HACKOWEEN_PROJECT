# ========================================================
# KISAN CULTURE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ========================================================

# 1. Google Gemini API Key (Optional)
# Get a free-tier key at https://aistudio.google.com/
# Used for multimodal leaf pathology vision and dynamic response synthesis.
# If omitted, system seamlessly runs on grounded ICAR offline rule matrices.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. Application Frontend URL
APP_URL="http://localhost:3000"

# 3. Backend Configuration
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# 4. SQLite Database Persistence
DATABASE_URL="sqlite:///./kisan_culture.db"

# 5. Meteorological Provider
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1"

# 6. Upload Limits (Images and PDF test cards)
MAX_UPLOAD_SIZE_MB=25

